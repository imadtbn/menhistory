{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Figure",
  "type": "object",
  "required": ["slug", "nameAr", "nameEn", "birth", "fields", "era", "summary", "sources"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "nameAr": { "type": "string", "minLength": 2 },
    "nameEn": { "type": "string", "minLength": 2 },
    "alternateNames": { "type": "array", "items": { "type": "string" } },
    "birth": {
      "type": "object",
      "required": ["date"],
      "properties": {
        "date": { "type": "string" },
        "place": { "type": "string" },
        "precision": { "enum": ["exact", "year", "century", "unknown"] }
      }
    },
    "death": {
      "type": ["object", "null"],
      "properties": {
        "date": { "type": "string" },
        "place": { "type": "string" }
      }
    },
    "nationality": { "type": ["string", "null"] },
    "geography": {
      "type": "object",
      "properties": {
        "regions": { "type": "array", "items": { "type": "string" } },
        "countries": { "type": "array", "items": { "type": "string" } }
      }
    },
    "culturalBackground": { "type": "array", "items": { "type": "string" } },
    "fields": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "array", "items": { "type": "string" } }
      }
    },
    "era": { "type": "string" },
    "religion": { "type": ["object", "null"] },
    "political": { "type": ["object", "null"] },
    "image": { "type": "object" },
    "summary": { "type": "string" },
    "notableFor": { "type": "string" },
    "timeline": { "type": "array" },
    "biography": { "type": "object" },
    "relatedFigures": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url", "publisher", "type"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "publisher": { "type": "string" },
          "type": { "type": "string" },
          "accessed": { "type": "string" },
          "supports": { "type": "string" }
        }
      }
    },
    "status": { "enum": ["published", "draft"] },
    "confidence": { "enum": ["high", "medium", "low"] }
  }
}